flowchart LR
  %% Evidence: backend/src/routes/auth.rs, backend/src/services/jwt.rs, backend/src/services/sessions.rs
  issue["Register / login / refresh\nIssue access and refresh tokens"]
  access["Access token\nActive or bounded previous kid"]
  refresh["Refresh family and current token valid"]
  stale["Authoritative identity changed\nVersion or role mismatch"]
  accessExpired["Access token expired"]
  rotate["Refresh request\nAdvisory lock and row lock"]
  revoked["Family revoked or compromised"]
  refreshExpired["Refresh token expired"]
  one["Revoke one opaque session ID"]
  all["Logout all / privileged revoke\nRevoke families and increment auth_version"]

  issue --> access
  issue --> refresh
  access -->|exp reached| accessExpired
  access -->|Middleware reloads current identity| stale
  stale -->|Reject immediately| accessExpired
  refresh --> rotate
  rotate -->|One-time predecessor update| issue
  rotate -->|Reuse detected| revoked
  refresh -->|expires_at reached| refreshExpired
  refresh --> one
  refresh --> all
  one --> revoked
  all --> revoked
  all -->|Version mismatch| stale
